generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model activity_logs {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  project_id   String?    @db.Uuid
  user_id      String?    @db.Uuid
  action       String     @db.VarChar(100)
  entity_type  String     @db.VarChar(50)
  entity_id    String?    @db.Uuid
  metadata     Json?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  projects     projects?  @relation(fields: [project_id, workspace_id], references: [id, workspace_id], onDelete: Cascade, onUpdate: NoAction)
  users        users?     @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([project_id, created_at], map: "idx_activity_logs_project_created")
  @@index([workspace_id, created_at], map: "idx_activity_logs_workspace_created")
}

model ai_conversations {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id   String        @db.Uuid
  workspace_id String        @db.Uuid
  user_id      String        @db.Uuid
  title        String?       @db.VarChar(200)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @db.Timestamptz(6)
  projects     projects      @relation(fields: [project_id, workspace_id], references: [id, workspace_id], onDelete: Cascade, onUpdate: NoAction)
  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_messages  ai_messages[]

  @@index([project_id, updated_at], map: "idx_ai_conversations_project_updated")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_messages {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id  String           @db.Uuid
  role             String
  content          String
  model_name       String?          @db.VarChar(100)
  input_tokens     Int?
  output_tokens    Int?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  ai_conversations ai_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at], map: "idx_ai_messages_conversation_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model automation_actions {
